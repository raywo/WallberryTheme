{% if photoElement %}
	{{ setBackgroundTint(photoData.color) }}

	<div class="wb-unsplash-bg-attribution">{{ "PHOTO_BY" | translate({author: photoData.authorName}) }}</div>
	<img src="{{ photoElement.src }}" style="opacity: {{ config.brightImageOpacity if photoData.isLight else config.backgroundOpacity }};">

	{% if "top" in config.addBackgroundFade %}
		<div class="topfade wbfade" style="height: {{ getHeight("region top bar") }}px;"></div>
	{% endif %}
	{% if "bottom" in config.addBackgroundFade %}
		<div class="bottomfade wbfade" style="height: {{ getHeight("region bottom bar") }}px;"></div>
	{% endif %}

{% elif photoError %}
	<div class="wb-unsplash-bg-error">
		<div class="wb-error-reason"><i class="wb-error-icon fa fa-exclamation-triangle" aria-hidden="true"></i>{{ "ERROR_TITLE" | translate }}<i class="wb-error-icon fa fa-exclamation-triangle" aria-hidden="true"></i></div>
		<div class="wb-error-info">{{ photoError.key | translate(photoError.variables) }}</div>
	</div>
{% else %}
	<div class="wb-unsplash-bg-attribution">{{ "LOADING_PHOTO" | translate }}</div>
{% endif %}
